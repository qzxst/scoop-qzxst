    "architecture": {
        "64bit": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.2/Cherry-Studio-2.0.2-x64-setup.exe#dl.7z",
            "hash": "sha512:d6424d6341c851597aaacad5a15ba71741a8d119d81120e768a50c64b4395476902c5bf879e0bc02677b189e6c99fac64c740ca12ca5be2fb1346f515a410774"
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.2/Cherry-Studio-2.0.2-arm64-setup.exe#dl.7z ",
            "hash": "sha512:d6424d6341c851597aaacad5a15ba71741a8d119d81120e768a50c64b4395476902c5bf879e0bc02677b189e6c99fac64c740ca12ca5be2fb1346f515a410774"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
    ],
    "bin": [
        "Cherry Studio.exe",
        "Cherry Studio",
        "--user-data-dir=\"$dir\\User Data\""
    ],
    "shortcuts": [
        [
            "Cherry Studio.exe",
            "Cherry Studio",
            "--user-data-dir=\"$dir\\User Data\""
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "github": "https://github.com/CherryHQ/cherry-studio",
        "regex": "/CherryHQ/cherry-studio/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm).*?sha512:\\s+$base64"
        },
        "architecture": {
            "64bit": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-x64-setup.exe#dl.7z"
            },
            "arm64": {
                "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v$version/Cherry-Studio-$version-arm64-setup.exe#dl.7z "
            }
        }
    }
}
